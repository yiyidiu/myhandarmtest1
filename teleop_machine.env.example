# Copy to teleop_machine.env and set only this computer's dependency paths.
# No motion, filter, frequency or gain parameters are changed here.
teleop_configuration_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TELEOP_HAMER_PYTHON="$HOME/anaconda3/envs/hamer_rtx2060/bin/python"
export MEDIAPIPE_ENV_PREFIX="$HOME/anaconda3/envs/mediapipe_env"
export MEDIAPIPE_PYTHON="$MEDIAPIPE_ENV_PREFIX/bin/python"
export REALSENSE_SITE_PACKAGES="$MEDIAPIPE_ENV_PREFIX/lib/python3.10/site-packages"
export TELEOP_IMU_PYTHON="$MEDIAPIPE_PYTHON"
export TELEOP_HAMER_ASSET_ROOT="$teleop_configuration_root/perception_hamer/_DATA"
export PYTHONPATH="$teleop_configuration_root/third_party/hamer_runtime${PYTHONPATH:+:$PYTHONPATH}"
