<?xml version="1.0"?>
<launch>
  <!-- One ROS/Gazebo stack, one hand commander, and no MoveIt/RViz nodes. -->
  <arg name="gazebo_gui" default="true"/>
  <arg name="paused" default="false"/>

  <include file="$(find handarm_sim_demo)/launch/simulation_baseline.launch">
    <arg name="gazebo_gui" value="$(arg gazebo_gui)"/>
    <arg name="rviz" value="false"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="start_moveit" value="false"/>
    <arg name="initialize_arm_trajectory" value="true"/>
    <arg name="run_avoidance_demo" value="false"/>
    <arg name="run_pick_demo" value="false"/>
    <arg name="simulation" value="true"/>
    <arg name="use_real_robot" value="false"/>
    <arg name="use_real_hand" value="false"/>
  </include>

  <node name="hand_commander" pkg="handarm_sim_demo"
        type="hand_commander.py" output="screen" required="true">
    <param name="hand_config"
           value="$(find handarm_sim_demo)/config/hand_commands.yaml"/>
  </node>
</launch>
