<?xml version="1.0"?>
<package format="2">
  <name>handarm_sim_demo</name>
  <version>0.1.0</version>
  <description>Simulation-only ABB IRB120 and three-finger hand avoidance and scripted pick baseline.</description>
  <maintainer email="yiyidiu@users.noreply.github.com">yiyidiu</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>actionlib</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_commander</depend>
  <depend>moveit_msgs</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>abb120_moveit_config1</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_control</exec_depend>
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>roboticsgroup_upatras_gazebo_plugins</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>

  <export/>
</package>
