<?xml version="1.0"?>
<sdf version="1.6">
  <world name="handarm_three_finger_large_xy_probe_02">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints><cfm>0.0</cfm><erp>0.2</erp><contact_max_correcting_vel>0.1</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
    </physics>
    <include><uri>model://ground_plane</uri></include><include><uri>model://sun</uri></include>
    <model name="work_table">
      <static>true</static><pose>0.65 0 0.33 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry><box><size>0.80 0.90 0.08</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction><contact><ode><kp>1000000</kp><kd>10</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.80 0.90 0.08</size></box></geometry><material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.55 0.38 0.20 1</diffuse></material></visual>
      </link>
    </model>
    <model name="target_object">
      <static>false</static><pose>0.34 0 0.44 0 0 0</pose>
      <link name="object_link">
        <inertial><mass>0.10</mass><inertia><ixx>0.0002166667</ixx><iyy>0.0002041667</iyy><izz>0.0000941667</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.07 0.08 0.14</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2><slip1>0.0</slip1><slip2>0.0</slip2></ode></friction><contact><ode><kp>1000000</kp><kd>10</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.07 0.08 0.14</size></box></geometry><material><ambient>0.10 0.65 0.15 1</ambient><diffuse>0.10 0.85 0.20 1</diffuse></material></visual>
        <sensor name="target_contact_sensor" type="contact">
          <always_on>true</always_on><update_rate>100.0</update_rate><contact><collision>collision</collision></contact>
          <plugin name="target_contact_reporter" filename="libgazebo_ros_bumper.so"><alwaysOn>true</alwaysOn><updateRate>100.0</updateRate><frameName>world</frameName><bumperTopicName>/handarm_sim_demo/target_contacts</bumperTopicName></plugin>
        </sensor>
      </link>
    </model>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.7 0.7 1</background></scene>
    <gui fullscreen="0"><camera name="user_camera"><pose>1.4 -1.2 1.2 0 0.37 2.23</pose><view_controller>orbit</view_controller><projection_type>perspective</projection_type></camera></gui>
  </world>
</sdf>
