<?xml version="1.0"?>
<sdf version="1.6">
  <world name="handarm_pick_obstacle">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="work_table">
      <static>true</static>
      <pose>0.65 0 0.33 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry><box><size>0.80 0.90 0.08</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.80 0.90 0.08</size></box></geometry>
          <material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.55 0.38 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="target_object">
      <static>false</static>
      <pose>0.50 0.05 0.42 0 0 0</pose>
      <link name="object_link">
        <inertial><mass>0.10</mass><inertia><ixx>0.000104</ixx><iyy>0.000104</iyy><izz>0.000042</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.10</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.10</size></box></geometry>
          <material><ambient>0.10 0.65 0.15 1</ambient><diffuse>0.10 0.85 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_a">
      <static>true</static>
      <pose>0.36 0.04 0.545 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="collision"><geometry><box><size>0.08 0.26 0.35</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.26 0.35</size></box></geometry>
          <material><ambient>0.75 0.10 0.10 1</ambient><diffuse>0.90 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_b">
      <static>true</static>
      <pose>0.54 -0.20 0.51 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="collision"><geometry><box><size>0.08 0.18 0.28</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.18 0.28</size></box></geometry>
          <material><ambient>0.10 0.25 0.75 1</ambient><diffuse>0.15 0.35 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.7 0.7 1</background></scene>
  </world>
</sdf>
