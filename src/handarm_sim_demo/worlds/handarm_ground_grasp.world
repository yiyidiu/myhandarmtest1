<?xml version="1.0"?>
<sdf version="1.6">
  <!-- Table-free physical scene. Every graspable object rests on z=0. -->
  <world name="handarm_ground_grasp">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <!-- SOR=1.0 avoids over-relaxed contact corrections that made the
             small finger links alternate across an object surface. -->
        <solver><type>quick</type><iters>100</iters><sor>1.0</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="target_object">
      <static>false</static>
      <!-- 100 mm high: centre is 50 mm above the ground plus 1 mm settling gap. -->
      <pose>0.48 0.00 0.051 0 0 0</pose>
      <link name="object_link">
        <inertial>
          <mass>0.10</mass>
          <inertia><ixx>0.0001133333</ixx><iyy>0.0001041667</iyy><izz>0.0000508333</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.06 0.10</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2><slip1>0.0001</slip1><slip2>0.0001</slip2></ode></friction>
            <contact><ode><kp>100000</kp><kd>100</kd><max_vel>0.02</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.06 0.10</size></box></geometry>
          <material><ambient>0.10 0.65 0.15 1</ambient><diffuse>0.10 0.85 0.20 1</diffuse></material>
        </visual>
        <sensor name="target_contact_sensor" type="contact">
          <always_on>true</always_on><update_rate>100.0</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="target_contact_reporter" filename="libgazebo_ros_bumper.so">
            <alwaysOn>true</alwaysOn><updateRate>100.0</updateRate>
            <frameName>world</frameName>
            <bumperTopicName>/handarm_sim_demo/target_contacts</bumperTopicName>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="ground_object_left">
      <static>false</static>
      <!-- 80 mm high. -->
      <pose>0.40 0.28 0.041 0 0 0</pose>
      <link name="object_link">
        <inertial><mass>0.08</mass><inertia><ixx>0.00008</ixx><iyy>0.00008</iyy><izz>0.00008</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.06 0.06 0.08</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2><slip1>0.0001</slip1><slip2>0.0001</slip2></ode></friction>
            <contact><ode><kp>100000</kp><kd>100</kd><max_vel>0.02</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.08</size></box></geometry>
          <material><ambient>0.10 0.25 0.75 1</ambient><diffuse>0.15 0.35 0.90 1</diffuse></material>
        </visual>
        <sensor name="left_object_contact_sensor" type="contact">
          <always_on>true</always_on><update_rate>100.0</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="left_object_contact_reporter" filename="libgazebo_ros_bumper.so">
            <alwaysOn>true</alwaysOn><updateRate>100.0</updateRate>
            <frameName>world</frameName>
            <bumperTopicName>/handarm_sim_demo/left_object_contacts</bumperTopicName>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="ground_object_right">
      <static>false</static>
      <!-- 120 mm high. -->
      <pose>0.40 -0.28 0.061 0 0 0</pose>
      <link name="object_link">
        <inertial><mass>0.12</mass><inertia><ixx>0.00015</ixx><iyy>0.00015</iyy><izz>0.00010</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.08 0.05 0.12</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2><slip1>0.0001</slip1><slip2>0.0001</slip2></ode></friction>
            <contact><ode><kp>100000</kp><kd>100</kd><max_vel>0.02</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.05 0.12</size></box></geometry>
          <material><ambient>0.80 0.35 0.08 1</ambient><diffuse>0.95 0.45 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.7 0.7 1</background></scene>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.55 -1.45 1.25 0 0.38 2.28</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
