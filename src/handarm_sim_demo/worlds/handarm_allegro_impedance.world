<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.6">
  <world name="handarm_allegro_impedance">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.0005</max_step_size>
      <real_time_update_rate>2000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <include>
      <uri>model://ground_plane</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <model name="pinch_stand">
      <static>true</static>
      <pose>0.493 -0.054 0.195 0 0 0</pose>
      <link name="support">
        <collision name="support"><geometry><box><size>0.085 0.095 0.390</size></box></geometry></collision>
        <visual name="support"><geometry><box><size>0.085 0.095 0.390</size></box></geometry>
          <material><ambient>0.32 0.36 0.40 1</ambient><diffuse>0.32 0.36 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="target_object">
      <pose>0.493 -0.054 0.4171 0 0 0</pose>
      <link name="object_link">
        <inertial><mass>0.018</mass><inertia><ixx>0.00000796094</ixx><iyy>0.00000796094</iyy><izz>0.00000367199</izz></inertia></inertial>
        <collision name="barrel">
          <pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.044</length></cylinder></geometry>
          <surface><friction>
            <ode><mu>0.85</mu><mu2>0.85</mu2></ode>
            <torsional><coefficient>0.8</coefficient><use_patch_radius>true</use_patch_radius>
              <patch_radius>0.0035</patch_radius></torsional>
          </friction></surface>
        </collision>
        <visual name="barrel"><pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.044</length></cylinder></geometry>
          <material><ambient>0.12 0.55 0.48 1</ambient><diffuse>0.12 0.55 0.48 1</diffuse></material>
        </visual>
        <collision name="upper_rim">
          <pose>0 0 0.0245 0 0 0</pose><geometry><cylinder><radius>0.026</radius><length>0.005</length></cylinder></geometry>
          <surface><friction>
            <ode><mu>0.85</mu><mu2>0.85</mu2></ode>
            <torsional><coefficient>0.8</coefficient><use_patch_radius>true</use_patch_radius>
              <patch_radius>0.0035</patch_radius></torsional>
          </friction></surface>
        </collision>
        <visual name="upper_rim"><pose>0 0 0.0245 0 0 0</pose><geometry><cylinder><radius>0.026</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.12 0.55 0.48 1</ambient><diffuse>0.12 0.55 0.48 1</diffuse></material>
        </visual>
        <collision name="lower_rim">
          <pose>0 0 -0.0245 0 0 0</pose><geometry><cylinder><radius>0.026</radius><length>0.005</length></cylinder></geometry>
          <surface><friction>
            <ode><mu>0.85</mu><mu2>0.85</mu2></ode>
            <torsional><coefficient>0.8</coefficient><use_patch_radius>true</use_patch_radius>
              <patch_radius>0.0035</patch_radius></torsional>
          </friction></surface>
        </collision>
        <visual name="lower_rim"><pose>0 0 -0.0245 0 0 0</pose><geometry><cylinder><radius>0.026</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.12 0.55 0.48 1</ambient><diffuse>0.12 0.55 0.48 1</diffuse></material>
        </visual>
        <visual name="orientation_mark"><pose>0.011 0 0.0271 0 0 0</pose>
          <geometry><box><size>0.019 0.003 0.0002</size></box></geometry>
          <material><ambient>1 0.85 0.30 1</ambient><diffuse>1 0.85 0.30 1</diffuse></material>
        </visual>
        <sensor name="object_contacts" type="contact">
          <always_on>true</always_on><update_rate>100</update_rate><contact><collision>barrel</collision><collision>upper_rim</collision><collision>lower_rim</collision></contact>
          <plugin name="object_contact_feedback" filename="libgazebo_ros_bumper.so">
            <frameName>world</frameName><bumperTopicName>/handarm_sim_demo/target_contacts</bumperTopicName>
          </plugin>
        </sensor>
      </link>
    </model>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.6 -1.05 1.45 0 0.615737453 2.480549485</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
      <plugin name="handarm_gui_render_rate_limiter" filename="libhandarm_gui_render_rate_limiter_plugin.so">
        <renderRateHz>15.0</renderRateHz>
      </plugin>
    </gui>
  </world>
</sdf>
