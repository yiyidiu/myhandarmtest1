<?xml version="1.0"?>
<launch>
  <!-- New opt-in EGM position-reference profile. The established velocity
       entry live_human_ground_gazebo_teleop.launch is intentionally untouched. -->
  <arg name="gazebo_gui" default="true" />
  <arg name="arm_control_mode" default="position" />
  <arg name="grasp_alignment_views" default="false" />
  <arg name="with_ground_object" default="true" />
  <arg name="empty_motion_scene" default="false" />
  <arg name="use_simulated_environment_for_control" default="false"
       doc="Offline comparison only: expose Gazebo world geometry to the controller. Live teleoperation has no environment perception and must leave this false." />
  <arg name="enable_logger" default="true" />
  <arg name="input_source" default="udp"
       doc="udp for the live camera; direction_test is reserved for automated full-chain validation" />
  <arg name="mapping_profile" default="current_linear"
       doc="current_linear uses the shared translation/rotation gains; camera_ground_workspace requires a measured per-operator range" />
  <arg name="constrained_velocity_projection" default="false"
       doc="Gazebo constrained differential IK; false preserves the previous controller for comparison." />
  <arg name="joint_velocity_solver" default="qp"
       doc="qp or servo; both use the modern shared feedback, hand protection and 250 Hz reference when constrained_velocity_projection is true." />
  <arg name="position_accommodation_m" default="0.0"
       doc="Experimental per-axis position envelope for constrained orientation accommodation; zero retains the recorded controller." />
  <arg name="hamer_input_timeout_s" default="0.40" />
  <arg name="hamer_maximum_pipeline_latency_s" default="0.20" />
  <arg name="use_moveit_servo_safety" default="true"
       doc="true enables Servo plus swept collision gate; false is direct-IK rollback" />
  <arg name="legacy_moveit_servo_reference"
       default="$(arg use_moveit_servo_safety)"
       doc="deprecated compatibility alias" />
  <arg name="stable_position_reference_profile" default="true"
       doc="false restores the previous aggressive EGM response" />
  <arg name="hand_stability_profile" default="physical_grasp"
       doc="original restores the v0.3 hand PID/mimic plant for A/B rollback" />
  <arg name="log_directory" default="/tmp/handarm_ground_egm_teleop_logs" />
  <arg name="camera_workspace_calibration_file"
       default="$(find handarm_moveit_demo)/config/camera_workspace_calibration.yaml" />
  <arg name="safe_initial_joint_positions"
       default=" -J f1j1 0.18 -J f1j2 0.08726646259971647 -J f2j1 0.08726646259971647 -J f3j2 0.08726646259971647 -J joint_1 0.0 -J joint_2 0.0 -J joint_3 0.0 -J joint_4 0.0 -J joint_5 1.5707963267948966 -J joint_6 0.0"
       doc="Restore the user-approved GitHub 09f9bd4 initial arm pose; arrange the workcell around this reference." />
  <arg name="empty_ground_world"
       default="$(find handarm_sim_demo)/worlds/handarm_ground_workspace.world" />
  <arg name="ground_object_world"
       default="$(find handarm_sim_demo)/worlds/handarm_ground_grasp.world" />
  <arg name="world_name"
       default="$(eval find('handarm_sim_demo') + '/worlds/handarm_motion_only.world' if arg('empty_motion_scene') else (arg('ground_object_world') if arg('with_ground_object') else arg('empty_ground_world')))" />
  <arg name="planning_scene_scenario"
       default="$(eval 'bare_ground' if arg('empty_motion_scene') else ('ground_objects' if arg('with_ground_object') else 'ground_only'))" />

  <include file="$(find handarm_moveit_demo)/launch/shared_teleop_egm_position_demo.launch">
    <arg name="gazebo_gui" value="$(arg gazebo_gui)" />
    <arg name="arm_control_mode" value="$(arg arm_control_mode)" />
    <arg name="input_source" value="$(arg input_source)" />
    <arg name="enable_logger" value="$(arg enable_logger)" />
    <arg name="log_directory" value="$(arg log_directory)" />
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="mapping_profile" value="$(arg mapping_profile)" />
    <arg name="require_scene_ready" value="$(arg use_simulated_environment_for_control)" />
    <arg name="hamer_input_timeout_s" value="$(arg hamer_input_timeout_s)" />
    <arg name="hamer_maximum_pipeline_latency_s"
         value="$(arg hamer_maximum_pipeline_latency_s)" />
    <arg name="camera_workspace_calibration_file"
         value="$(arg camera_workspace_calibration_file)" />
    <arg name="safe_initial_joint_positions"
         value="$(arg safe_initial_joint_positions)" />
    <arg name="initial_arm_reference"
         value="[0.0, 0.0, 0.0, 0.0, 1.5707963267948966, 0.0]" />
    <arg name="legacy_moveit_servo_reference"
         value="$(arg legacy_moveit_servo_reference)" />
    <arg name="run_servo_server"
         value="$(eval not (arg('constrained_velocity_projection') and arg('joint_velocity_solver') == 'qp'))" />
    <arg name="stable_position_reference_profile"
         value="$(arg stable_position_reference_profile)" />
    <arg name="hand_stability_profile"
         value="$(arg hand_stability_profile)" />
  </include>

  <param name="/shared_teleop/control/constrained_velocity_projection"
         value="$(arg constrained_velocity_projection)" />
  <param name="/shared_teleop/control/joint_velocity_solver"
         value="$(arg joint_velocity_solver)" />
  <!-- The 5 mm Servo stop-distance trial still reached finger/arm contact.
       Its fixed margin needs room for physical tracking and braking error;
       QP instead reserves these terms dynamically above its 5 mm base.
       Preserve the same final swept check for both controllers. -->
  <group if="$(eval arg('joint_velocity_solver') == 'servo')">
    <param name="/servo_server/collision_check_type" value="stop_distance" />
    <param name="/servo_server/min_allowable_collision_distance" value="0.015" />
    <param name="/servo_server/collision_distance_safety_factor" value="1.5" />
  </group>
  <param name="/shared_teleop/control/position_accommodation_m"
         value="$(arg position_accommodation_m)" />

  <!-- The scene remains in Gazebo for rendering and physical contact.
       Do not give the controller simulator-only object/table coordinates.
       This opt-in path exists only to reproduce earlier offline runs. -->
  <node if="$(arg use_simulated_environment_for_control)"
        name="teleop_scene_manager" pkg="handarm_sim_demo"
        type="scene_manager.py" output="screen" required="true">
    <param name="scene_config"
           value="$(find handarm_sim_demo)/config/ground_grasp_scene.yaml" />
    <param name="scenario" value="$(arg planning_scene_scenario)" />
    <param name="startup_timeout" value="90.0" />
    <param name="wait_for_startup_ready" value="false" />
    <param name="allow_grasp_contacts" value="true" />
  </node>

  <node if="$(arg grasp_alignment_views)" name="grasp_alignment_views"
        pkg="handarm_sim_demo" type="grasp_alignment_views.py" output="screen">
    <param name="rate_hz" value="5.0" />
    <!-- Used only to restore props on the observer's T key, never by control. -->
    <param name="object_home_world" value="$(arg world_name)" />
    <env name="GDK_SCALE" value="1" />
    <env name="GDK_DPI_SCALE" value="1" />
  </node>

</launch>
