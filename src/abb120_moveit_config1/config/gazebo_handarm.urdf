    </transmission>
    <!-- <transmission name="trans_f3j3">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="f3j3">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="f3j3_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission> -->
    <transmission name="trans_f2j1">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="f2j1">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="f2j1_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <!-- <transmission name="trans_f2j2">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="f2j2">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="f2j2_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission> -->
    <transmission name="trans_joint_1">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="joint_1">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="joint_1_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="trans_joint_2">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="joint_2">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="joint_2_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="trans_joint_3">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="joint_3">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="joint_3_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="trans_joint_4">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="joint_4">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="joint_4_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="trans_joint_5">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="joint_5">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="joint_5_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="trans_joint_6">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="joint_6">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="joint_6_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <!-- Explicit rubber-like finger/object friction for physical grasping. -->
    <gazebo reference="f1link1"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
    <gazebo reference="f1link2"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
    <gazebo reference="f1link3"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
    <gazebo reference="f2link1"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
    <gazebo reference="f2link2"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
    <gazebo reference="f3link1"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
    <gazebo reference="f3link2"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
    <gazebo reference="f3link3"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
    <!-- Physics-level self-collision backstop for the complete arm and hand. -->
    <gazebo reference="base_link"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="link_1"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="link_2"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="link_3"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="link_4"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="link_5"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="link_6"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="handbase_link"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="f1link1"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="f1link2"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="f1link3"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="f2link1"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="f2link2"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="f3link1"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="f3link2"><selfCollide>true</selfCollide></gazebo>
    <gazebo reference="f3link3"><selfCollide>true</selfCollide></gazebo>
    <gazebo>
        <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
            <robotNamespace>/</robotNamespace>
        </plugin>
    </gazebo>
    <gazebo>
      <!-- Force-limited coupled joints. No SetPosition branch is used. -->
      <plugin name="mimic_f3j1_from_f1j1" filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so">
        <joint>f1j1</joint>
        <mimicJoint>f3j1</mimicJoint>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <hasPID>gazebo_ros_control/pid_gains/f3j1</hasPID>
        <forceSign>1.0</forceSign>
        <maxEffort>4.0</maxEffort>
        <diagnosticVelocityThreshold>0.05</diagnosticVelocityThreshold>
        <robotNamespace>/</robotNamespace>
        <sensitiveness>0.0005</sensitiveness>
      </plugin>
      <plugin name="mimic_f1j3_from_f1j2" filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so">
        <joint>f1j2</joint>
        <mimicJoint>f1j3</mimicJoint>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <hasPID>gazebo_ros_control/pid_gains/f1j3</hasPID>
        <forceSign>1.0</forceSign>
        <maxEffort>0.20</maxEffort>
        <nearTargetEffort>0.05</nearTargetEffort>
        <nearTargetError>0.04</nearTargetError>
        <diagnosticVelocityThreshold>0.05</diagnosticVelocityThreshold>
        <robotNamespace>/</robotNamespace>
        <sensitiveness>0.0005</sensitiveness>
      </plugin>
      <plugin name="mimic_f2j2_from_f2j1" filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so">
        <joint>f2j1</joint>
        <mimicJoint>f2j2</mimicJoint>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <hasPID>gazebo_ros_control/pid_gains/f2j2</hasPID>
        <forceSign>1.0</forceSign>
        <maxEffort>0.20</maxEffort>
        <nearTargetEffort>0.05</nearTargetEffort>
        <nearTargetError>0.04</nearTargetError>
        <diagnosticVelocityThreshold>0.05</diagnosticVelocityThreshold>
        <robotNamespace>/</robotNamespace>
        <sensitiveness>0.0005</sensitiveness>
      </plugin>
      <plugin name="mimic_f3j3_from_f3j2" filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so">
        <joint>f3j2</joint>
        <mimicJoint>f3j3</mimicJoint>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <hasPID>gazebo_ros_control/pid_gains/f3j3</hasPID>
        <forceSign>1.0</forceSign>
        <maxEffort>0.20</maxEffort>
        <nearTargetEffort>0.05</nearTargetEffort>
        <nearTargetError>0.04</nearTargetError>
        <diagnosticVelocityThreshold>0.05</diagnosticVelocityThreshold>
        <robotNamespace>/</robotNamespace>
        <sensitiveness>0.0005</sensitiveness>
      </plugin>
    </gazebo>
</robot>
