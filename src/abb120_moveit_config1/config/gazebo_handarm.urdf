        <axis xyz="0 1 0" />
        <dynamics damping="0.0" friction="0.0" />
    </joint>
    <joint name="joint_4" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0.07" />
        <parent link="link_3" />
        <child link="link_4" />
        <limit effort="100" lower="-2.79253" upper="2.79253" velocity="5.58505" />
        <axis xyz="1 0 0" />
        <dynamics damping="0.0" friction="0.0" />
    </joint>
    <joint name="joint_5" type="revolute">
        <origin rpy="0 0 0" xyz="0.302 0 0" />
        <parent link="link_4" />
        <child link="link_5" />
        <limit effort="100" lower="-2.094395" upper="2.094395" velocity="5.58505" />
        <axis xyz="0 1 0" />
        <dynamics damping="0.0" friction="0.0" />
    </joint>
    <joint name="joint_6" type="revolute">
        <origin rpy="0 0 0" xyz="0.072 0 0" />
        <parent link="link_5" />
        <child link="link_6" />
        <limit effort="100" lower="-6.981317" upper="6.981317" velocity="7.33038" />
        <axis xyz="1 0 0" />
        <dynamics damping="0.5" friction="0.0" />
    </joint>
    <!-- end of joint list -->
    <!-- ROS-Industrial 'base' frame: base_link to ABB World Coordinates transform -->
    <!-- <link name="${prefix}base" />
    <joint name="${prefix}base_link-base" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint> -->
    <link name="world" />
    <joint name="world-base_link-fixed" type="fixed">
        <parent link="world" />
        <child link="base_link" />
    </joint>
    <!-- ROS-Industrial 'flange' frame: attachment point for EEF models -->
    <link name="flange" />
    <joint name="joint_6-flange" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="link_6" />
        <child link="flange" />
    </joint>
    <!-- ROS-Industrial 'tool0' frame: all-zeros tool frame -->
    <link name="tool0" />
    <joint name="link_6-tool0" type="fixed">
        <origin rpy="0 1.5707963267948966 0" xyz="0.17 0 0" />
        <parent link="flange" />
        <child link="tool0" />
    </joint>
    <transmission name="trans_f1j1">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="f1j1">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="f1j1_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="trans_f1j2">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="f1j2">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="f1j2_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <!-- <transmission name="trans_f1j3">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="f1j3">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="f1j3_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
