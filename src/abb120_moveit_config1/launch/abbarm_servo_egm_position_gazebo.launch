<?xml version="1.0"?>
<launch>
  <!-- Simulation-only: no physical-output switch is exposed. -->
  <arg name="start_server" default="true" />
  <!-- QP also reads the established joint/singularity parameters. Keep
       them loaded when the unused Servo process is not started. -->
  <rosparam ns="servo_server"
            file="$(find abb120_moveit_config1)/config/servo_abbarm_egm_position_gazebo.yaml"
            command="load" />
  <node if="$(arg start_server)" name="servo_server" pkg="moveit_servo" type="servo_server" output="screen"
        launch-prefix="$(optenv TELEOP_CONTROL_LAUNCH_PREFIX)">
  </node>
</launch>
