<?xml version="1.0"?>
<launch>
  <!-- Independent Gazebo plant for EGM-style position-reference emulation. -->
  <arg name="gazebo_gui" default="true" />
  <arg name="arm_control_mode" default="position" />
  <arg name="paused" default="false" />
  <arg name="world_name" default="worlds/empty.world" />
  <arg name="world_pose" default="-x 0 -y 0 -z 0 -R 0 -P 0 -Y 0" />
  <!-- Only robot_description is rendered. The canonical URDF is unchanged,
       and original remains an immediate rollback for controlled A/B tests. -->
  <arg name="hand_stability_profile" default="physical_grasp"
       doc="physical_grasp, rigid_transport, or original" />
  <arg name="initial_joint_positions"
       default=" -J f1j1 0.18 -J f1j2 0.08726646259971647 -J f2j1 0.08726646259971647 -J f3j2 0.08726646259971647 -J joint_1 0.0 -J joint_2 0.0 -J joint_3 0.0 -J joint_4 0.0 -J joint_5 1.5707963267948966 -J joint_6 0.0" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch" pass_all_args="true">
    <arg name="paused" value="true" />
    <arg name="gui" value="$(arg gazebo_gui)" />
  </include>

  <!-- Use PositionJointInterface plus finite-effort P/D gains. Unlike the
       preserved velocity plant, gravity remains enabled in this URDF. -->
  <param name="robot_description"
         command="$(find handarm_sim_demo)/scripts/render_teleop_hand_urdf.py --input $(find abb120_moveit_config1)/config/gazebo_handarm.urdf --profile $(arg hand_stability_profile) --arm-control $(arg arm_control_mode)" />
  <rosparam file="$(find abb120_moveit_config1)/config/gazebo_controllers.yaml" />
  <!-- Use the published 250 Hz reference velocity, not differences of
       stepped position samples, in the 1 kHz physical arm PID. -->
  <param name="/gazebo_ros_control/use_reference_velocity_derivative"
         value="$(eval arg('hand_stability_profile') == 'physical_grasp')" />
  <!-- Keep the new arm tuning isolated from the established speed profile. -->
  <rosparam command="load"
            file="$(find handarm_sim_demo)/config/gazebo_arm_egm_position_pid.yaml"
            ns="gazebo_ros_control/pid_gains" />
  <rosparam if="$(eval arg('hand_stability_profile') == 'original')"
            command="load"
            file="$(find handarm_sim_demo)/config/gazebo_hand_only_pid.yaml"
            ns="gazebo_ros_control/pid_gains" />
  <include if="$(eval arg('arm_control_mode') == 'position')" file="$(find abb120_moveit_config1)/launch/ros_controllers_egm_position.launch">
    <arg name="spawn_hand_controller"
         value="$(eval arg('hand_stability_profile') != 'physical_grasp')" />
  </include>
  <group if="$(eval arg('arm_control_mode') == 'velocity')">
    <rosparam file="$(find abb120_moveit_config1)/config/ros_controllers_velocity.yaml" />
    <rosparam param="/gazebo_ros_control/direct_velocity_gains">[40.0, 75.0, 44.0, 10.4, 11.1, 3.0]</rosparam>
    <node name="controller_spawner" pkg="controller_manager" type="spawner"
          args="abbarm_velocity_controller" required="true" output="screen" />
  </group>
  <!-- Preserve the standard hand FollowJointTrajectory API while one
       self-locking drive/passive-coupling plugin owns all eight Gazebo hand joints. -->
  <node if="$(eval arg('hand_stability_profile') == 'physical_grasp')"
        name="physical_hand_trajectory_action_server"
        pkg="handarm_sim_demo"
        type="physical_hand_trajectory_action_server.py"
        respawn="false" required="true" output="screen">
    <rosparam param="joint_names">[f1j1, f1j2, f2j1, f3j2]</rosparam>
    <param name="command_topic" value="/controller_gazebo_hand/command" />
    <param name="action_name"
           value="/controller_gazebo_hand/follow_joint_trajectory" />
    <param name="default_goal_tolerance_rad" value="0.05" />
  </node>

  <arg name="unpause" value="$(eval '' if arg('paused') else '-unpause')" />
  <node name="spawn_gazebo_model" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model robot $(arg unpause) $(arg world_pose) $(arg initial_joint_positions)"
        respawn="false" output="screen" />
  <node name="gazebo_controller_spawner" pkg="controller_manager" type="spawner"
        respawn="false" output="screen" args="joint_state_controller" />
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" respawn="true" output="screen" />
</launch>
