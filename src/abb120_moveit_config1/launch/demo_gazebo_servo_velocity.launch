<?xml version="1.0"?>
<launch>
  <!-- Complete simulation launch: Gazebo + MoveIt + MoveIt Servo + direct velocity controller -->
  <arg name="pipeline" default="ompl" />
  <arg name="gazebo_gui" default="true" />
  <arg name="paused" default="false" />
  <arg name="world_name" default="worlds/empty.world" />
  <arg name="world_pose" default="-x 0 -y 0 -z 0 -R 0 -P 0 -Y 0" />

  <include file="$(find abb120_moveit_config1)/launch/demo_gazebo_velocity.launch">
    <arg name="pipeline" value="$(arg pipeline)" />
    <arg name="gazebo_gui" value="$(arg gazebo_gui)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="world_pose" value="$(arg world_pose)" />
  </include>

  <include file="$(find abb120_moveit_config1)/launch/abbarm_servo_velocity.launch" />
</launch>
