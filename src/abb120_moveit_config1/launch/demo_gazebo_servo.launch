<?xml version="1.0"?>
<launch>
  <!-- Complete simulation launch: Gazebo + MoveIt + MoveIt Servo + position bridge -->
  <arg name="pipeline" default="ompl" />
  <arg name="gazebo_gui" default="true" />
  <arg name="paused" default="false" />
  <arg name="world_name" default="worlds/empty.world" />
  <arg name="world_pose" default="-x 0 -y 0 -z 0 -R 0 -P 0 -Y 0" />

  <include file="$(find abb120_moveit_config1)/launch/demo_gazebo.launch">
    <arg name="pipeline" value="$(arg pipeline)" />
    <arg name="gazebo_gui" value="$(arg gazebo_gui)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="world_pose" value="$(arg world_pose)" />
  </include>

  <include file="$(find abb120_moveit_config1)/launch/abbarm_servo.launch" />

  <node pkg="handarm_moveit_demo"
        type="servo_velocity_to_position_bridge.py"
        name="servo_velocity_to_position_bridge"
        output="screen">
    <param name="raw_servo_topic" value="/servo_server/raw_joint_cmds" />
    <param name="controller_topic" value="/controller_gazebo/command" />
    <param name="integration_dt" value="0.12" />
    <param name="time_from_start" value="0.10" />
    <param name="max_joint_step" value="0.02" />
    <rosparam param="arm_joints">[joint_1, joint_2, joint_3, joint_4, joint_5, joint_6]</rosparam>
  </node>
</launch>
